  classical
  obtain ⟨B, hBA, hB, S, f, p, r, g, h,
      hzeroS, hwitness, hAvoid, hpData, hrData,
      hjointDisjoint, hg, hh⟩ :=
    counterexample_forces_triplySelfRepairedOptionReservoir
      hbasis hzeroA hcounter
  have hpA : ∀ b ∈ B, p b ∈ A := by
    intro b hb
