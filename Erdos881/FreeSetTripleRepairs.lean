    intro b hb hrbB
    exact Set.disjoint_left.mp (hg b hb).2.2.1
      (Finset.mem_coe.mpr
        (Finset.sdiff_subset (hrData b hb).1)) hrbB
  have hpr : ∀ b ∈ B, p b ≠ r b := by
    intro b hb hEq
