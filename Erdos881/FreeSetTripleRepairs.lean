          ⟨r.1, Finset.mem_erase.mpr ⟨hrq, r.2⟩⟩
        ⟨(cOther r').1, (cOther r').2⟩
    have hfullCases : ∀ x,
        x ∈ finiteSupportChoiceUnion cFull →
          x ∈ insert 0 E.1 ∨ x ∈ U := by
      intro x hx
      obtain ⟨r, _hrAttach, hxr⟩ := Finset.mem_biUnion.mp hx
      by_cases hrq : r.1 = q
      · left
        simpa [cFull, hrq] using hxr
      · right
        let r' : {n // n ∈ Q'} :=
