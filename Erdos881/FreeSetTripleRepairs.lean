  obtain ⟨e, F, P, hcore, hcellCard⟩ :=
    exists_finiteBlockPartition_for_atomPetalRepairPointCells
      hBA hB p r hpA hrA hpOut hrOut hpr hoptionsDisjoint
  let cell : ℕ → Finset ℕ := fun i =>
    atomPetalRepairPointCell p r (e i).1
