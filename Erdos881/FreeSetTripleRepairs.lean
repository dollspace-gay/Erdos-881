    ⟨chosen r, hchosenMem r⟩
  let U : Finset ℕ := finiteSupportChoiceUnion cOther
  have hUDisjoint : Disjoint (U : Set ℕ) (selectedSet s) := by
    rw [Set.disjoint_left]
    intro x hxU hxSelected
