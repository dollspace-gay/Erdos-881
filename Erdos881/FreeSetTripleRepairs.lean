          (additiveSupportFamily A 2 q).card <
            (3 * Q₀.card + 1) *
              (destroyedCertificateTargets A B Q₀).card) ∨
        ∃ systems : Finset (Finset ℕ),
          systems.card = 3 * Q₀.card + 1 ∧
          IsMatching systems ∧
          (∀ S ∈ systems,
