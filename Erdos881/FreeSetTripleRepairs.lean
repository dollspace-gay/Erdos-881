  obtain ⟨q₀, hq₀Q₀, _hq₀Destroy⟩ := hcert₀ arbitrarySelector
  have hQ₀ : Q₀.Nonempty := ⟨q₀, hq₀Q₀⟩
  have htriple₀ : ∀ q ∈ Q₀,
