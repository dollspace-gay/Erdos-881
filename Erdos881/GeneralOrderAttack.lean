theorem IsExactTupleAsymptoticBasis.eventually_successorLockedPrefix_matching_or_rankGrowthDescent
    {A K : Set ℕ} {k : ℕ}
    (hbasis : IsExactTupleAsymptoticBasis A k)
    {F : ℕ → Finset ℕ} (P : IsFiniteBlockPartition K F)
