          r < M.card ∧
          (∀ E ∈ M, R ⊆ E) ∧
          (∀ E ∈ M, (E \ R).Nonempty) ∧
          ∀ E ∈ M, ∀ G ∈ M, E ≠ G →
            Disjoint (E \ R) (G \ R)) ∨
        ∃ d, additiveSupportFamily A (k + 1) d = ∅ ∧
          ∃ B : Set ℕ, B ⊆ A ∧ B.Infinite ∧
