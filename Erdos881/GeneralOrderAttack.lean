  obtain ⟨E₀, hE₀R, _hE₀empty⟩ := hN₀ q hqLate
  have hrepresented :
      (additiveSupportFamily A (k + 1) q).Nonempty :=
    ⟨E₀, hE₀R⟩
  obtain ⟨D, hDselected, _hDcard, hDdestroy⟩ :=
