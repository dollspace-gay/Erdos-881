        (∃ q, L ≤ q ∧ ∃ d, d ∈ A ∧ d ≤ q ∧
          ∃ R : Finset ℕ, ∃ M : Finset (Finset ℕ),
            R.card < k ∧
            M ⊆ additiveSupportFamily A k (q - d) ∧
            r < M.card ∧
            (∀ E ∈ M, R ⊆ E) ∧
            (∀ E ∈ M, (E \ R).Nonempty) ∧
            ∀ E ∈ M, ∀ G ∈ M, E ≠ G →
              Disjoint (E \ R) (G \ R)) ∨
        ∃ q, L ≤ q ∧ ∃ b, b ∈ A ∧ b ∉ W ∧ b ≤ q ∧
          additiveSupportFamily A k (q - b) = ∅) := by
  classical
  obtain ⟨F, P, _hFcard⟩ :=
