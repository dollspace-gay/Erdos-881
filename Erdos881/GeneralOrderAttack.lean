  refine ⟨max N₀ N₁, ?_⟩
  intro Q hQcard hlate hcert hblocks
  by_cases hExact :
      ∃ q ∈ Q,
        B < (additiveSupportFamily A (k + 1) q).card
  · exact Or.inl hExact
  by_cases hDifference :
      ∃ q ∈ Q, ∃ d, d ∈ A ∧ d ≤ q ∧
        B < (additiveSupportFamily A k (q - d)).card
  · exact Or.inr hDifference
  have hExactBound :
