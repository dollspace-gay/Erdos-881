geometry on a fixed partition. -/
theorem boundedFullTranslateDestroyers_fixedGrowingCertificate_cofinalMatching_or_crossedRectangles
    {A : Set ℕ} {k q₀ : ℕ}
    (hbasis : IsExactTupleAsymptoticBasis A (k + 1))
