          R.card < k + 1 ∧
          M ⊆ additiveSupportFamily A (k + 1) q ∧
          r < M.card ∧
          (∀ E ∈ M, R ⊆ E) ∧
          (∀ E ∈ M, (E \ R).Nonempty) ∧
          ∀ E ∈ M, ∀ G ∈ M, E ≠ G →
